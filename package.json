{
  "name": "grocerylistapp",
  "version": "1.0.0",
  "private": true,
  "description": "A modern notepad-style grocery list PWA with smart categories, swipe-to-delete, dark mode, and more.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-dist.mjs",
    "preview": "vite preview",
    "export-seed-data": "node scripts/export-seed-data.mjs",
    "export-ios-catalog": "node scripts/export-ios-catalog.mjs",
    "verify-category-detection": "node scripts/verify-category-detection.mjs",
    "verify-product-resolution": "node scripts/verify-product-resolution.mjs",
    "generate-og-image": "python3 scripts/generate-og-image.py",
    "ios:process-product-sources": "python3 GroceryListiOS/scripts/process-product-sources.py",
    "ios:download-store-logos": "python3 GroceryListiOS/scripts/download-store-logos.py",
    "ios:reprocess-store-logos": "python3 GroceryListiOS/scripts/download-store-logos.py --reprocess-only",
    "ios:normalize-catalog-assets": "python3 GroceryListiOS/scripts/normalize-catalog-assets.py"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
